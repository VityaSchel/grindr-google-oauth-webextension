{
	"manifest_version": 2,
	"name": "Grindr Google OAuth",
	"version": "0.1.0",
	"description": "Sign in with Google on Grindr for 3rd party Grindr clients",
	"browser_specific_settings": {
		"gecko": {
			"id": "grindr-google-oauth-webextension@opengrind.org",
			"strict_min_version": "115.0"
		},
		"gecko_android": {
			"strict_min_version": "115.0"
		}
	},
	"content_security_policy": "script-src 'self'; object-src 'self'",
	"permissions": ["nativeMessaging", "https://web.grindr.com/*"],
	"browser_action": {
		"default_title": "Sign in with Google"
	},
	"background": {
		"scripts": ["src/background.js"]
	},
	"content_scripts": [
		{
			"matches": ["https://web.grindr.com/*"],
			"js": ["src/content.js"],
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": ["shared/gis-core.js", "src/page-runner.js"]
}
